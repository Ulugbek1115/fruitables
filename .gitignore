# ============================================================================
# Python & Django Core
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Django specific artifacts
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Media and Static directories (User uploads and gathered static assets)
# Do not track files uploaded by users or compiled frontend assets
media/
staticfiles/

# ============================================================================
# Environments & Packages
# ============================================================================
# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging, distribution, and installations
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pipenv, Poetry, and Pip log files
pip-log.txt
pip-delete-this-directory.txt
.history/

# ============================================================================
# Environments & Secrets
# ============================================================================
# Never commit credentials, secrets, or local environment overrides
.env
.secrets
*.env
*.ini

# ============================================================================
# Testing and Coverage
# ============================================================================
# Inline test suites, profiling data, and test reports
htmlcov/
.tox/
.nosexml/
coverage.xml
*.cover
*.py,cover
.coverage
.coverage.*
.cache
nosetests.xml
shippable.yml
.pytest_cache/
.pytest_cache/

